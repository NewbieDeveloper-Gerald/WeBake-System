# =====================================================================
# WeBake frontend - deploy-time settings (documentation, not auto-loaded).
# The storefront is static HTML/CSS/JS with no build step, so these values
# are consumed by editing "customer/js/config.js" (one line) OR by setting
# them as Vercel environment variables and injecting them into config.js
# during deploy. This file exists so the checklist lives in one place.
# =====================================================================

# REQUIRED at deploy time. Base URL of the Render API, WITHOUT trailing slash.
# Local dev:  http://localhost:5000/api
# Production: https://webake-api.onrender.com/api
WEBAKE_API_BASE=http://localhost:5000/api

# Canonical logo path. The file "assets/logo.png" is the single source of
# truth; to rebrand, replace that file (and "assets/favicon.png") - no code
# changes needed.
WEBAKE_LOGO_PATH=assets/logo.png
