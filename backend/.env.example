# =====================================================================
# WeBake backend - environment template.
# Copy to ".env" and fill in real values. NEVER commit ".env" to git.
# Every variable below is documented. If a variable is marked REQUIRED,
# the server refuses to boot without it (see src/config/env.js).
# =====================================================================

# --- Server ---
# Port the API listens on. Render injects PORT automatically; keep 5000 locally.
PORT=5000
# One of: development | production. Controls error detail and cookie flags.
NODE_ENV=development

# --- Database (Supabase PostgreSQL) ---
# REQUIRED. Use the Supabase shared SESSION pooler string (port 5432) on Render, because
# Render's free tier runs one small instance and the pooler handles reconnects.
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@POOLER-HOST:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Alternative to DATABASE_URL: set the five parts below instead. Ignored when
# DATABASE_URL is present. DB_PORT is 5432 for the shared Session pooler, 6543 for transaction mode.
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=postgres

# --- Auth (REQUIRED) ---
# Secret used to sign JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-32-char-minimum-secret
# Cost factor for bcrypt password hashing. 12 is a safe default (OWASP guidance).
BCRYPT_ROUNDS=12
# How long login sessions last. Members stay signed in 7 days, admin 12 hours.
MEMBER_JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h

# --- CORS allowlist ---
# The ONLY browser origin allowed to call this API in production (your Vercel URL).
# Example: FRONTEND_URL=https://webake.vercel.app
FRONTEND_URL=http://localhost:3000
# Extra origin allowed for local development. Leave empty in production.
DEV_ORIGIN=http://localhost:5500

# --- Seed script only (admin bootstrap) ---
# Email and password for the single owner account created by "npm run seed".
# The password is hashed with bcrypt before storage; it is never stored plain.
ADMIN_EMAIL=crbwebake@gmail.com
ADMIN_PASSWORD=change-me-before-seeding

# --- Email (Phase 4 - Brevo HTTP API) ---
# REQUIRED for OTP + receipts. Without BREVO_API_KEY the mailer is disabled
# and OTP endpoints answer 503. Get the key at Brevo dashboard > SMTP & API.
# IMPORTANT: verify BREVO_SENDER_EMAIL as a Sender in Brevo first (Settings >
# Senders - confirmation link), or Brevo rejects every send.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=crbwebake@gmail.com
BREVO_SENDER_NAME=WeBake - Crumbs N' Rolls Bakery

# --- Supabase Storage (Phase 4 - payment proofs, product images) ---
# Server-side key for uploads to the private payment-proofs bucket.
# NEVER expose the service-role key to the frontend. Buckets are created in
# the Supabase dashboard (Phase 7 guide): payment-proofs (PRIVATE),
# product-images (PUBLIC).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- OTP + reset tuning (safe defaults, rarely changed) ---
# Code expiry, resend cooldown, wrong-guess limit, verified-code lifetime.
OTP_CODE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_VERIFIED_TTL_MINUTES=30
# Admin reset-link lifetime.
RESET_TOKEN_MINUTES=30

# --- Business defaults (also editable in Settings once seeded) ---
# Default low-stock threshold in PIECES (500 pieces = 20 bundles of 25).
DEFAULT_LOW_STOCK_PIECES=500
# Minimum online order size in BUNDLES across all products (confirmed Q1).
MIN_ORDER_BUNDLES=300
